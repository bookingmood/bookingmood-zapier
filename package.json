{
  "name": "bookingmood-zapier",
  "version": "2.0.0",
  "description": "Bookingmood Zapier integration",
  "main": "index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "check-spec": "node scripts/sync-spec.mts --check",
    "format": "prettier --write src test scripts",
    "push": "pnpm validate && zapier-platform push",
    "sync-spec": "node scripts/sync-spec.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build && zapier-platform validate"
  },
  "dependencies": {
    "zapier-platform-core": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "nock": "15.0.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "zapier-platform-cli": "19.2.1"
  },
  "packageManager": "pnpm@12.15.0"
}
