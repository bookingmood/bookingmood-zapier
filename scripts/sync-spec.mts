// Downloads the public Bookingmood OpenAPI spec and derives the types the integration is checked against.
//
//   node scripts/sync-spec.mts          writes src/generated/*
//   node scripts/sync-spec.mts --check  fails when src/generated/* is out of date
//
// BOOKINGMOOD_OPENAPI_URL overrides the source, e.g. http://www.localhost:3000/api/v1/openapi.json
import { readFile, writeFile } from "node:fs/promises";

const url =
  process.env["BOOKINGMOOD_OPENAPI_URL"] ??
  "https://api.bookingmood.com/v1/openapi.json";
const check = process.argv.includes("--check");

const specPath = new URL("../src/generated/openapi.json", import.meta.url);
const typesPath = new URL("../src/generated/spec-types.ts", import.meta.url);

type Spec = {
  components: {
    schemas: Record<
      string,
      { properties?: Record<string, unknown>; enum?: Array<string> }
    >;
  };
  paths: Record<string, Record<string, unknown>>;
};

const response = await fetch(url);
if (!response.ok)
  throw new Error(
    `Fetching ${url} failed: ${response.status} ${response.statusText}`,
  );
const spec = (await response.json()) as Spec;

const webhookEvents = spec.components.schemas["WebhookEvent"]?.enum;
if (!webhookEvents)
  throw new Error(`${url} does not describe the WebhookEvent schema`);

// Tables are the schemas that back a path, the other schemas describe custom endpoints
const tables = Object.keys(spec.components.schemas)
  .filter((name) => `/${name}` in spec.paths)
  .sort();

const union = (values: Array<string>) =>
  values.length
    ? values.map((value) => JSON.stringify(value)).join(" | ")
    : "never";

const types = `// Generated by scripts/sync-spec.mts. Do not edit.

export type Table = ${union(tables)};

export type Columns = {
${tables
  .map(
    (table) =>
      `  ${table}: ${union(Object.keys(spec.components.schemas[table]?.properties ?? {}).sort())};`,
  )
  .join("\n")}
};

export type WebhookEvent = ${union(webhookEvents)};
`;

const files: Array<[URL, string]> = [
  [specPath, `${JSON.stringify(spec, null, 2)}\n`],
  [typesPath, types],
];

if (check) {
  const outdated = new Array<string>();
  for (const [path, content] of files)
    if ((await readFile(path, "utf8").catch(() => "")) !== content)
      outdated.push(path.pathname.split("/src/")[1] ?? path.pathname);
  if (outdated.length) {
    console.error(
      `The Bookingmood API changed: ${outdated.join(", ")} differ from ${url}. Run \`pnpm sync-spec\` and \`pnpm test -u\`, and review the diff of surface.json.`,
    );
    process.exit(1);
  }
  console.log("The spec is up to date");
} else {
  for (const [path, content] of files) await writeFile(path, content);
  console.log(
    `Synced ${tables.length} tables and ${webhookEvents.length} webhook events from ${url}`,
  );
}
